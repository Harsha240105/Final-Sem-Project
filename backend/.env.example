# Server Configuration
PORT=5001
MONGO_URI=mongodb+srv://web3admin:YOUR_URL_ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/web3connect?retryWrites=true&w=majority
ALLOW_START_WITHOUT_DB=true
MONGO_RETRY_INTERVAL_MS=15000
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=set_a_strong_admin_creation_secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Blockchain Configuration (Polygon Amoy Testnet)
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=0xyour_64_hex_character_owner_private_key

# IPFS / Pinata Configuration
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Supabase Configuration (optional migration path)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_USERNAME=your_supabase_db_username
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Web3Connect <noreply@web3connect.com>

# SMS (Twilio) Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
